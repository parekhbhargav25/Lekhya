generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Receipt {
  id               String              @id @default(cuid())
  userId           String
  s3Key            String?
  s3Url            String?
  status           String              @default("uploaded")
  extractedJson    Json?
  createdAt        DateTime            @default(now())
  categoryOverride String?
  source           String              @default("upload")
  externalId       String?
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  corrections      ReceiptCorrection[]

  @@unique([userId, externalId])
}

model ReceiptCorrection {
  id           String   @id @default(cuid())
  receiptId    String
  userFeedback String
  previousJson Json
  newJson      Json
  createdAt    DateTime @default(now())
  receipt      Receipt  @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([receiptId])
}

model User {
  id                  String                       @id @default(cuid())
  email               String                       @unique
  name                String?
  createdAt           DateTime                     @default(now())
  password            String?
  emailVerifiedAt     DateTime?
  receipts            Receipt[]
  googleAccount       GoogleAccount?
  verificationCodes   EmailVerificationCode[]
  duplicateDismissals ReceiptDuplicateDismissal[]
}

model ReceiptDuplicateDismissal {
  id          String   @id @default(cuid())
  userId      String
  fingerprint String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fingerprint])
  @@index([userId])
}

model EmailVerificationCode {
  id        String   @id @default(cuid())
  userId    String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model GoogleAccount {
  id                String    @id @default(cuid())
  userId            String    @unique
  providerAccountId String
  accessToken       String
  refreshToken      String?
  expiresAt         DateTime?
  scope             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model WaitlistSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}
